// Prisma schema for Wadinoor Portal ERP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        String   @default("CUSTOMER")
  permissions String   @default("{}")
  createdAt   DateTime @default(now())

  trips       Trip[]
  expenses    Expense[]
  travelers   Traveler[] @relation("TravelerCreatedBy")
  collections TripCollection[] @relation("CollectionReceivedBy")
  customerProfile CustomerProfile?
  createdDesigns CatalogueDesign[] @relation("DesignCreatedBy")
  updatedDesigns CatalogueDesign[] @relation("DesignUpdatedBy")
  createdPackages EventPackage[] @relation("EventPackageCreatedBy")
  updatedPackages EventPackage[] @relation("EventPackageUpdatedBy")
  enquiries     EventEnquiry[] @relation("CustomerEnquiries")
  activity      ActivityLog[]
  createdQuotations Quotation[] @relation("QuotationCreatedBy")
  updatedQuotations Quotation[] @relation("QuotationUpdatedBy")
  quotationHistory QuotationHistory[] @relation("QuotationHistoryBy")
}

model BusinessProfile {
  id                  Int      @id @default(1)
  businessName        String   @default("EVERLUXE EVENTS")
  publicEmail         String   @default("everluxeevents123@gmail.com")
  phone               String   @default("+91 97452 27257")
  whatsapp            String   @default("+91 97452 27257")
  instagram           String   @default("ever.luxe_events")
  location            String   @default("Nilambur, Malappuram, Kerala, India")
  serviceArea         String   @default("Across Kerala")
  description         String?  @db.Text
  heroMode            String   @default("DEFAULT")
  heroImageUrl        String?
  logoUrl             String?
  updatedAt           DateTime @updatedAt
}

model CustomerProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  phone       String?
  whatsapp    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventProfiles EventProfile[]
}

model EventProfile {
  id          Int      @id @default(autoincrement())
  customerId  Int
  title       String
  eventTypeId Int?
  eventDate   DateTime?
  location    String?
  guestCount  Int?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  eventType   EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  enquiries   EventEnquiry[]
}

model CatalogueCategory {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  slug         String   @unique
  imageUrl     String?
  displayOrder Int      @default(0)
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  designs      CatalogueDesign[]
}

model DesignStyle {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  slug         String   @unique
  description  String?  @db.Text
  imageUrl     String?
  displayOrder Int      @default(0)
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  designs      CatalogueDesign[]
  budgetRanges BudgetRange[]
}

model EventType {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  slug         String   @unique
  imageUrl     String?
  displayOrder Int      @default(0)
  status       String   @default("PUBLISHED")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  designs      CatalogueDesign[]
  enquiries    EventEnquiry[]
  eventProfiles EventProfile[]
}

model CatalogueDesign {
  id              Int      @id @default(autoincrement())
  publicId        String   @unique
  name            String
  slug            String   @unique
  description     String?  @db.Text
  categoryId      Int?
  eventTypeId     Int?
  designStyleId   Int?
  price           Decimal? @db.Decimal(12, 2)
  priceType       String   @default("ON_REQUEST")
  priceVisibility String   @default("HIDDEN")
  availability    String   @default("AVAILABLE")
  status          String   @default("DRAFT")
  featured        Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdById     Int
  updatedById     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  category        CatalogueCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  eventType       EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  designStyle     DesignStyle? @relation(fields: [designStyleId], references: [id], onDelete: SetNull)
  createdBy       User @relation("DesignCreatedBy", fields: [createdById], references: [id])
  updatedBy       User @relation("DesignUpdatedBy", fields: [updatedById], references: [id])
  images          CatalogueImage[]
  packageItems    EventPackageItem[]
  enquiryItems    EnquiryDesign[]
}

model CatalogueImage {
  id          Int      @id @default(autoincrement())
  designId    Int
  url         String
  altText     String?
  sortOrder   Int      @default(0)
  isCover     Boolean  @default(false)
  createdAt   DateTime @default(now())
  design      CatalogueDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
}

model EventPackage {
  id              Int      @id @default(autoincrement())
  publicId        String   @unique
  name            String
  slug            String   @unique
  description     String?  @db.Text
  price           Decimal? @db.Decimal(12, 2)
  priceType       String   @default("ON_REQUEST")
  priceVisibility String   @default("HIDDEN")
  availability    String   @default("AVAILABLE")
  status          String   @default("DRAFT")
  featured        Boolean  @default(false)
  displayOrder    Int      @default(0)
  coverImageUrl   String?
  createdById     Int
  updatedById     Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       User @relation("EventPackageCreatedBy", fields: [createdById], references: [id])
  updatedBy       User @relation("EventPackageUpdatedBy", fields: [updatedById], references: [id])
  items           EventPackageItem[]
  enquiryItems    EnquiryPackage[]
}

model EventPackageItem {
  id        Int @id @default(autoincrement())
  packageId Int
  designId  Int
  sortOrder Int @default(0)
  package   EventPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  design    CatalogueDesign @relation(fields: [designId], references: [id], onDelete: Restrict)
  @@unique([packageId, designId])
}

model GalleryItem {
  id           Int      @id @default(autoincrement())
  title        String
  caption      String?  @db.Text
  imageUrl     String
  mediaType    String   @default("IMAGE")
  category     String   @default("Other Events")
  eventTypeId  Int?
  designStyleId Int?
  displayOrder Int      @default(0)
  status       String   @default("DRAFT")
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EventEnquiry {
  id             Int      @id @default(autoincrement())
  reference      String   @unique
  customerId     Int?
  fullName       String
  phone          String
  whatsapp       String?
  eventTypeId    Int?
  eventDate      DateTime?
  eventLocation  String?
  guestCount     Int?
  preferredStyle String?
  budgetRange    String?
  message        String?  @db.Text
  status         String   @default("NEW")
  adminNotes     String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       User? @relation("CustomerEnquiries", fields: [customerId], references: [id], onDelete: SetNull)
  eventType      EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)
  selectedDesigns EnquiryDesign[]
  selectedPackages EnquiryPackage[]
  selectedAddons  EnquiryAddon[]
  eventProfile   EventProfile? @relation(fields: [eventProfileId], references: [id], onDelete: SetNull)
  eventProfileId Int?
  attachments    EnquiryAttachment[]
  quotations     Quotation[]
}

model EnquiryAttachment {
  id          Int      @id @default(autoincrement())
  enquiryId   Int
  fileUrl     String
  originalName String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  enquiry     EventEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
}

model BudgetRange {
  id          Int      @id @default(autoincrement())
  label       String   @unique
  minAmount   Decimal? @db.Decimal(12, 2)
  maxAmount   Decimal? @db.Decimal(12, 2)
  displayOrder Int     @default(0)
  status      String   @default("PUBLISHED")
  styleId     Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  style       DesignStyle? @relation(fields: [styleId], references: [id], onDelete: SetNull)
}

model ApprovedAddon {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  imageUrl    String?
  price       Decimal? @db.Decimal(12, 2)
  status      String   @default("DRAFT")
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  enquiryItems EnquiryAddon[]
}

model EnquiryAddon {
  id        Int @id @default(autoincrement())
  enquiryId Int
  addonId   Int
  addonName String
  price     Decimal? @db.Decimal(12, 2)
  enquiry   EventEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  addon     ApprovedAddon @relation(fields: [addonId], references: [id], onDelete: Restrict)
  @@unique([enquiryId, addonId])
}

model Quotation {
  id          Int      @id @default(autoincrement())
  reference   String   @unique
  enquiryId   Int
  status      String   @default("DRAFT")
  currency    String   @default("INR")
  subtotal    Decimal? @db.Decimal(12, 2)
  total       Decimal? @db.Decimal(12, 2)
  notes       String?  @db.Text
  snapshot    String   @db.Text
  createdById Int
  updatedById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  enquiry     EventEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdBy   User @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  updatedBy   User @relation("QuotationUpdatedBy", fields: [updatedById], references: [id])
  history     QuotationHistory[]
}

model QuotationHistory {
  id          Int      @id @default(autoincrement())
  quotationId Int
  changedById Int
  action      String
  snapshot    String   @db.Text
  createdAt   DateTime @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  changedBy   User @relation("QuotationHistoryBy", fields: [changedById], references: [id])
}

model EnquiryDesign {
  id          Int      @id @default(autoincrement())
  enquiryId   Int
  designId    Int
  designName  String
  price       Decimal? @db.Decimal(12, 2)
  priceType   String
  priceVisible Boolean @default(false)
  enquiry     EventEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  design      CatalogueDesign @relation(fields: [designId], references: [id], onDelete: Restrict)
  @@unique([enquiryId, designId])
}

model EnquiryPackage {
  id          Int      @id @default(autoincrement())
  enquiryId   Int
  packageId   Int
  packageName String
  price       Decimal? @db.Decimal(12, 2)
  priceType   String
  priceVisible Boolean @default(false)
  enquiry     EventEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  package     EventPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  @@unique([enquiryId, packageId])
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   String
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Package {
  id            Int    @id @default(autoincrement())
  packageName   String
  route         String
  durationDays  Int
  departureDay  String
  departureTime String
  trips         Trip[]
}


model Driver {
  id            Int    @id @default(autoincrement())
  driverName    String
  phoneNumber   String?
  passportNumber String?
  trips         Trip[] @relation("TripDriver")
  coTrips       Trip[] @relation("TripCoDriver")
}

model Bus {
  id        Int      @id @default(autoincrement())
  busName   String
  busNumber String   @unique
  createdAt DateTime @default(now())
  trips     Trip[]
}

model Ameer {
  id            Int    @id @default(autoincrement())
  name          String
  phone         String?
  passportNumber String?
  notes         String?

  trips         Trip[]
  collections   TripCollection[]
}

model ServiceProvider {
  id           Int      @id @default(autoincrement())
  providerName String
  isMain       Boolean  @default(false)

  travelers    Traveler[]
  expenses     Expense[]
}

model Trip {
  id            Int      @id @default(autoincrement())
  packageId     Int
  tripDate      DateTime
  status        String   @default("OPEN")
  seasonalPrice Float
  notes         String?
  createdById   Int
  createdAt     DateTime @default(now())
  driverId      Int?
  coDriverId    Int?
  ameerId       Int?
  busId         Int?

  package       Package  @relation(fields: [packageId], references: [id])
  createdBy     User     @relation(fields: [createdById], references: [id])
  driver        Driver?  @relation("TripDriver", fields: [driverId], references: [id])
  coDriver      Driver?  @relation("TripCoDriver", fields: [coDriverId], references: [id])
  ameer         Ameer?   @relation(fields: [ameerId], references: [id])
  bus           Bus?     @relation(fields: [busId], references: [id])
  travelers     Traveler[]
  collections   TripCollection[]
  expenses      Expense[]
}

model Traveler {
  id                Int      @id @default(autoincrement())
  travelerName      String
  passportOrIqama   String
  phoneNumber       String
  travelerType      String
  familyCount       Int      @default(1)
  coPassengers      String?
  tripId            Int
  amountPaid        Float    @default(0) @map("paymentAmount")
  paymentType       String?
  paymentStatus     String   @default("UNPAID")
  paymentMethod     String   @default("Cash")
  extraRoomCharge   Float    @default(0)
  customPrice       Float    @default(0) @map("discountAmount")
  finalAmount       Float    @default(0)
  status            String   @default("ACTIVE")
  serviceProviderId Int?
  serviceDirection  String?
  createdById       Int?
  createdAt         DateTime @default(now())

  trip             Trip     @relation(fields: [tripId], references: [id])
  familyMembers    FamilyMember[]
  serviceProvider  ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  createdBy        User?    @relation("TravelerCreatedBy", fields: [createdById], references: [id])
}

model FamilyMember {
  id         Int      @id @default(autoincrement())
  travelerId Int
  name       String
  passportOrIqama String?
  createdAt  DateTime @default(now())

  traveler   Traveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime
  category    String
  description String
  amount      Float
  tripId      Int?
  serviceProviderId Int?
  createdById Int
  createdAt   DateTime @default(now())

  trip        Trip?    @relation(fields: [tripId], references: [id])
  serviceProvider ServiceProvider? @relation(fields: [serviceProviderId], references: [id])
  createdBy   User     @relation(fields: [createdById], references: [id])
}

model TripCollection {
  id                 Int      @id @default(autoincrement())
  tripId             Int
  ameerId            Int
  amountReceived     Float
  date               DateTime
  receivedByAdminId  Int
  createdAt          DateTime @default(now())

  trip               Trip     @relation(fields: [tripId], references: [id])
  ameer              Ameer    @relation(fields: [ameerId], references: [id])
  receivedByAdmin    User     @relation("CollectionReceivedBy", fields: [receivedByAdminId], references: [id])
}





