PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Generate a unique 48+ character secret for every deployment. Never reuse this example value.
JWT_SECRET="replace-with-a-unique-long-random-secret"
CLIENT_ORIGIN="http://localhost:5173"
UPLOADS_DIR="./uploads"
# Persistent media storage. Cloudinary is required for normal operation.
MEDIA_STORAGE_PROVIDER="cloudinary"
# CLOUDINARY_CLOUD_NAME="your-cloud-name"
# CLOUDINARY_API_KEY="your-api-key"
# CLOUDINARY_API_SECRET="your-api-secret"
# For an intentional offline-only local test, use MEDIA_STORAGE_PROVIDER="local".
